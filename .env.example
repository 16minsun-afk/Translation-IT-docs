# 브라우저에서 접근 가능한 API base URL. 비워 두면 개발 proxy의 /api 사용
VITE_API_BASE_URL=/api
# 개발 서버 proxy 대상 (Spring Boot 실행 주소로 변경)
API_PROXY_TARGET=http://localhost:8080
# Google OAuth Web client ID (public value from API.md)
VITE_GOOGLE_CLIENT_ID=142317490993-hj3283vukns16ku0rmno1ruimmimff1n.apps.googleusercontent.com
# Kakao Developers > app > JavaScript key (NOT REST key/admin key/client secret)
VITE_KAKAO_JAVASCRIPT_KEY=
